{
	"action": {
		"default_title": "Strava \u6d3b\u52a8\u6d77\u62a5"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"js": [
				"content.js"
			],
			"matches": [
				"https://www.strava.com/activities/*"
			],
			"run_at": "document_idle"
		}
	],
	"description": "\u5728 Strava \u6d3b\u52a8\u9875\u4e00\u952e\u8bfb\u53d6\u6d3b\u52a8\u8f68\u8ff9\uff0c\u751f\u6210\u53ef\u5bfc\u51fa\u7684\u5730\u56fe\u6d77\u62a5 PNG\uff08\u57fa\u4e8e MapToPoster\uff09\u3002",
	"host_permissions": [
		"https://*.basemaps.cartocdn.com/*",
		"https://*.tile.openstreetmap.org/*",
		"https://tiles.openfreemap.org/*",
		"https://server.arcgisonline.com/*",
		"https://tiles.basemaps.cartocdn.com/*"
	],
	"manifest_version": 3,
	"name": "Strava \u6d3b\u52a8\u6d77\u62a5 \u00b7 MapToPoster",
	"permissions": [
		"storage"
	],
	"version": "1.0.0"
}
